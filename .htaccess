RewriteEngine On

# ===== ПРОПУСКАЄМО API.PHP (без редиректу) =====
RewriteRule ^api\.php$ - [L]

# ===== HTTPS (якщо є SSL) =====
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ===== 404 =====
ErrorDocument 404 /404.html

# ===== ЗАХИСТ ПАПОК =====
Options -Indexes